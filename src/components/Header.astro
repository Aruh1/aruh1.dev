---
import MdiKeyboardArrowRight from "~icons/mdi/keyboard-arrow-right";
import MdiGithub from "~icons/mdi/github";
import MdiHeart from "~icons/mdi/heart";
import IcSharpEmail from "~icons/ic/sharp-email";
import MobileMenu from "./MobileMenu.astro";
import { navigationItems, socialLinks } from "../data/navigation";
import { site } from "../data/site";

const socialIconMap = {
    github: MdiGithub,
    sponsor: MdiHeart,
    email: IcSharpEmail,
};

type Props = {
    hideOnScroll?: boolean;
};

const { hideOnScroll = true } = Astro.props;
const brandLabel = site.name.toUpperCase();
---

<header
    class="site-header fixed left-0 right-0 top-0 z-[110] border-b border-border bg-background tracking-[0.08em] backdrop-blur text-text"
    data-hide-on-scroll={hideOnScroll ? 'true' : undefined}
>
    <div class="header-frame">
        <div class="flex justify-between h-full">
            <div class="flex">
                <a
                    class="header-brand-link flex h-full items-center border-r border-border px-5 text-lg text-text no-underline transition-colors hover:text-primary focus-visible:text-primary focus-visible:outline-none"
                    href="/"
                    aria-label={`${site.name} home`}
                >
                    {brandLabel}
                </a>
                <a
                    class="header-link flex items-center border-r border-border px-5 text-lg"
                    href="/#contact"
                >
                    <span class="header-link-content uppercase">
                        Available for hire
                    </span>
                </a>
            </div>

            <div class="desktop-header-nav h-full items-stretch">
                <div
                    class="flex flex-row h-full gap-px bg-border border-x border-border"
                >
                    {navigationItems.map((item) => (
                        <a
                            class="header-link px-4 sm:px-5"
                            href={item.href}
                            target={item.href.startsWith('http') ? '_blank' : undefined}
                            rel={item.href.startsWith('http') ? 'noreferrer' : undefined}
                        >
                            <span class="header-link-content">
                                <MdiKeyboardArrowRight /> {item.label}
                            </span>
                        </a>
                    ))}
                </div>

                <div
                    class="flex flex-row h-full gap-px bg-border"
                >
                    {socialLinks.map((item) => {
                        const Icon = socialIconMap[item.icon];

                        return (
                            <a
                                class="header-link header-link-icon w-12 sm:w-16"
                                href={item.href}
                                target={item.href.startsWith('mailto:') ? undefined : '_blank'}
                                rel={item.href.startsWith('mailto:') ? undefined : 'noreferrer'}
                                aria-label={item.label}
                            >
                                <span class="header-link-content header-link-content-icon">
                                    <Icon class={item.icon === 'sponsor' ? 'sponsor-heart' : undefined} />
                                </span>
                            </a>
                        );
                    })}
                </div>
            </div>

            <MobileMenu />
        </div>
    </div>
</header>

<style>
    .header-frame {
        height: 4rem;
    }

    .site-header {
        transition: transform 260ms ease-out;
    }

    .site-header.is-hidden {
        transform: translateY(-100%);
    }

    .header-brand-link {
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }

    .desktop-header-nav {
        display: none;
    }

    @media (min-width: 800px) {
        .desktop-header-nav {
            display: flex;
        }
    }

    .header-link {
        position: relative;
        display: flex;
        align-items: center;
        overflow: hidden;
        background: var(--color-background);
        color: inherit;
        text-decoration: none;
    }

    .header-link::before {
        content: "";
        position: absolute;
        inset: 0;
        transform: scaleX(0);
        transform-origin: left;
        background: var(--color-text);
        transition: transform 300ms ease-out;
    }

    .header-link:hover::before {
        transform: scaleX(1);
    }

    .header-link-content {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 0.25rem;
        transition: color 300ms ease-out;
    }

    .header-link:hover .header-link-content {
        color: var(--color-background);
    }

    .header-link-icon {
        justify-content: center;
    }

    .header-link-content-icon {
        font-size: 1.25rem;
    }

    .sponsor-heart {
        animation: sponsor-heartbeat 1.6s ease-in-out infinite;
        color: currentColor;
        transform-origin: center;
    }

    @media (prefers-reduced-motion: reduce) {
        .sponsor-heart {
            animation: none;
        }
    }

    @keyframes sponsor-heartbeat {
        0%,
        42%,
        70%,
        100% {
            color: currentColor;
            transform: scale(1);
        }

        52% {
            color: hsl(0 84% 60%);
            transform: scale(1.22);
        }

        60% {
            color: hsl(0 84% 60%);
            transform: scale(0.96);
        }
    }
</style>

<script>
    const header = document.querySelector('[data-hide-on-scroll="true"]');

    if (header instanceof HTMLElement) {
        let lastScrollY = window.scrollY;
        const scrollThreshold = 12;

        const updateHeaderVisibility = () => {
            const currentScrollY = Math.max(window.scrollY, 0);
            const delta = currentScrollY - lastScrollY;

            if (currentScrollY <= 8) {
                header.classList.remove('is-hidden');
                lastScrollY = currentScrollY;
                return;
            }

            if (Math.abs(delta) < scrollThreshold) {
                return;
            }

            header.classList.toggle('is-hidden', delta > 0);
            lastScrollY = currentScrollY;
        };

        window.addEventListener('scroll', updateHeaderVisibility, { passive: true });
        window.addEventListener(
            'pagehide',
            () => {
                window.removeEventListener('scroll', updateHeaderVisibility);
            },
            { once: true },
        );
    }
</script>
