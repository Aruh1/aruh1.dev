#!/usr/bin/env sh
set -eu

root_dir="$(git rev-parse --show-toplevel)"
cd "$root_dir"

if ! command -v bun >/dev/null 2>&1; then
    echo "pre-commit: bun is required but was not found in PATH." >&2
    exit 1
fi

echo "pre-commit: running lint"
bun run lint

echo "pre-commit: running tests"
bun run test

echo "pre-commit: running build"
bun run build

if bun run | grep -q '^  format'; then
    echo "pre-commit: running prettier"
    bun prettier:write

    if ! git diff --quiet; then
        echo "Prettier formatted files. Please review and stage the changes, then commit again."
        exit 1
    fi
fi

echo "pre-commit: passed"
